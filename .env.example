# --- Inference backend -------------------------------------------------------
# Provider for model inference. Currently supported: "ollama".
SMALLCODER_PROVIDER=ollama

# Base URL of the Ollama server (never commit a real host if it is private).
OLLAMA_BASE_URL=http://localhost:11434

# Model to drive the agent. Target models are <12B parameter coding models,
# e.g. a 7B Qwen coder or a <12B Gemma. Any Ollama model tag works.
OLLAMA_MODEL=qwen2.5-coder:7b

# How the model is asked for structured output:
#   json   - Ollama JSON mode (works on all recent Ollama versions)
#   schema - constrain output to the action JSON schema (needs Ollama >= 0.5)
#   off    - no constraint; rely on prompt + JSON extraction only
OLLAMA_FORMAT=json

# --- Runtime budgets ---------------------------------------------------------
# Approximate model context window (tokens). Also passed to Ollama as num_ctx.
SMALLCODER_CONTEXT_LIMIT=12000

# Maximum agent steps per run before giving up.
SMALLCODER_MAX_STEPS=30

# Per-command timeout in seconds for run_command / verification.
SMALLCODER_COMMAND_TIMEOUT=120

# HTTP timeout in seconds for a single model completion request.
SMALLCODER_REQUEST_TIMEOUT=300

# --- Safety ------------------------------------------------------------------
# Comma-separated allowlist of executables the agent may invoke via run_command.
# SMALLCODER_ALLOWED_COMMANDS=pytest,python,python3,npm,node,npx,ruff,mypy

# --- Observability -----------------------------------------------------------
# Where run trajectories are written (JSONL + full tool outputs).
SMALLCODER_RUNS_DIR=results/runs
